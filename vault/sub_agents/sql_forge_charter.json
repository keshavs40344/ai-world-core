).textContent)\" class=\"mt-2 bg-slate-800 text-slate-300 text-xs py-2 rounded\">Copy SQL</button></div></main><script>function genSQL(){const t=document.getElementById('table').value.trim()||'table_name';const raw=document.getElementById('data').value.trim();if(!raw){document.getElementById('out').textContent='// Enter valid CSV data';return;}const lines=raw.split('\n').map(l=>l.trim()).filter(l=>l);if(lines.length<2)return;const headers=lines[0].split(',').map(h=>h.trim());const stmts=lines.slice(1).map(l=>{const vals=l.split(',').map(v=>isNaN(v)?`'${v.trim()}'`:v.trim());return `INSERT INTO ${t} (${headers.join(', ')}) VALUES (${vals.join(', ')});`;});document.getElementById('out').textContent=stmts.join('\n');}</script></body></html>"
