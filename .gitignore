# =============================================================================
# Project Genesis / ai-world-core — .gitignore
# =============================================================================

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
eggs/
.eggs/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Transient Logs & Debug Artifacts
*.log
*.log.*
logs/
*.tmp
*.temp

# SQLite Database Temporary Files
*.db-wal
*.db-shm
*.db-journal

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/

# IDE & OS Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Release Gate Operator Tokens
release_gate/*.AUTHORIZE
release_gate/*.REJECT
release_gate/*.PENDING.md


# Vector database binaries
vault/chromadb/
genesise/state.db
genesis/state.db


# Sovereign Credentials & Vault Secrets
vault/secrets/
*.token
*.credential

# Autonomous Factory MVP Test Artifacts
autonomous_factory_mvp/*.db
autonomous_factory_mvp/test_sandbox/
control_gateway.db
live_deployments/
autonomous_world.db
urls.db
live_services/

