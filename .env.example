# ============================================================
# Project Genesis — Environment Configuration Template
# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit secrets.
# ============================================================

# ── Ollama ─────────────────────────────────────────────────
# Use 127.0.0.1 not localhost on Windows to avoid IPv6 issues
OLLAMA_HOST=http://127.0.0.1:11434

# Primary model (must be pulled: ollama pull mistral:7b)
OLLAMA_PRIMARY_MODEL=mistral:7b

# Fallback models (comma-separated, ascending size)
OLLAMA_FALLBACK_MODELS=phi3:mini,gemma2:2b

# Context window (Ollama defaults to 4096 — override here)
OLLAMA_CTX_WINDOW=8192

# Generation temperature (lower = more deterministic)
OLLAMA_TEMPERATURE=0.2

# RAM threshold in GB — below this, switch to fallback model
OLLAMA_RAM_THRESHOLD_GB=4.0


# ── Engine Scheduling ───────────────────────────────────────
# How often the RADAR → FOUNDRY cycle fires (seconds)
CYCLE_INTERVAL_SEC=3600

# Max Docker worker containers to run concurrently
MAX_CONCURRENT_WORKERS=2

# Circuit breaker: max test iterations before archiving failure
CIRCUIT_BREAKER_LIMIT=5


# ── RADAR Scraping ──────────────────────────────────────────
RADAR_RATE_LIMIT_SEC=1.5
RADAR_PYPI_TOP_N=50
RADAR_GITHUB_TOPICS=developer-tools,automation,cli,local-first,open-source


# ── Docker ──────────────────────────────────────────────────
# Leave blank to use auto-detection via docker.from_env()
# DOCKER_SOCKET=npipe:////./pipe/docker_engine
WORKER_IMAGE_NAME=genesis-worker:latest
CONTAINER_TIMEOUT_SEC=300


# ── ChromaDB ───────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
EMBEDDING_MODEL=all-MiniLM-L6-v2


# ── Governance ──────────────────────────────────────────────
TIER_B_POLL_INTERVAL_SEC=30
TIER_B_TIMEOUT_HOURS=72


# ── Monetization Stub (DISABLED by default) ─────────────────
# Set MONETIZATION_ENABLED=true and add your payout API key
# ONLY after manually configuring the payout integration.
MONETIZATION_ENABLED=false
OPERATING_RESERVE_PERCENT=25.0
# PAYOUT_API_KEY=your_key_here
